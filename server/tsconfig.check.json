{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "main.js",
        "**/*.js"
    ],
    "exclude": [
        "node_modules",
        "docs",
        "test",
        "build",
        "src"
    ]
}
